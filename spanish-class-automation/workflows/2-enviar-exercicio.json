    {
      "parameters": {
        "jsCode": "\nconst cfgLinhas = $('Ler config').all();\nconst cfg = {};\nfor (let i = 0; i < cfgLinhas.length; i++) {\n  const l = cfgLinhas[i].json;\n  if (l.chave) cfg[String(l.chave).trim()] = String(l.valor).trim();\n}\n\nif ((cfg.ativo || 'sim').toLowerCase() !== 'sim') return [];\n\nconst agora = new Date();\nconst nomes = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sab'];\nconst diaHoje = nomes[agora.getDay()];\nif (diaHoje === 'dom' || diaHoje === 'sab') return [];\n\nconst segunda = new Date(agora);\nconst desloca = agora.getDay() === 0 ? -6 : 1 - agora.getDay();\nsegunda.setDate(agora.getDate() + desloca);\nconst semanaHoje = segunda.toISOString().slice(0, 10);\n\nconst linhas = $input.all();\nconst saida = [];\nfor (let i = 0; i < linhas.length; i++) {\n  const r = linhas[i].json;\n  if (String(r.dia || '').trim() !== diaHoje) continue;\n  if (String(r.semana || '').trim() !== semanaHoje) continue;\n  if (String(r.status || '').trim().toLowerCase() !== 'aprovado') continue;\n  saida.push({ json: Object.assign({}, r, {\n    destino: cfg.destino,\n    instancia: cfg.instancia,\n    voice_id: cfg.voice_id\n  }) });\n}\nreturn saida;\n"
      },

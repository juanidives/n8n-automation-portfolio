    {
      "parameters": {
        "jsCode": "const linhas = $input.all();\nif (linhas.length === 0) return [];\n\nconst base = linhas[0].json;\nconst semana = String(base.semana || '').trim();\n\nconst dados = [];\nfor (let i = 0; i < linhas.length; i++) {\n  const r = linhas[i].json;\n  dados.push({\n    p: String(r.enunciado || '').trim(),\n    o: [r.opcao_a, r.opcao_b, r.opcao_c, r.opcao_d].filter(function (x) { return String(x || '').trim(); }).map(function (x) { return String(x).trim(); }),\n    g: String(r.gabarito || '').trim(),\n    e: String(r.explicacao || '').trim()\n  });\n}\n\nconst h = [];\nh.push('<!DOCTYPE html>');\nh.push('<html lang=\"es\"><head><meta charset=\"utf-8\">');\nh.push('<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">');\nh.push('<title>Desafío del día</title>');\nh.push('<style>');\nh.push(':root{--bg:#faf7f2;--card:#fff;--ink:#2b2b2b;--muted:#6b6b6b;--line:#e5ddd0;--ok:#1f8a4c;--okbg:#e8f5ec;--no:#b3261e;--nobg:#fbe9e7}');\nh.push('*{box-sizing:border-box}');\nh.push('body{margin:0 auto;padding:24px 16px 64px;max-width:640px;background:var(--bg);color:var(--ink);line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif}');\nh.push('h1{font-size:22px;margin:0 0 4px}');\nh.push('.sub{color:var(--muted);font-size:15px;margin:0 0 24px}');\nh.push('.q{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:16px}');\nh.push('.qt{font-size:18px;font-weight:600;margin:0 0 12px}');\nh.push('.opt{display:block;width:100%;text-align:left;padding:14px 16px;margin:8px 0;border:1px solid var(--line);border-radius:12px;background:var(--card);font-size:17px;font-family:inherit;color:inherit;cursor:pointer}');\nh.push('.opt.ok{background:var(--okbg);border-color:var(--ok);color:var(--ok);font-weight:600}');\nh.push('.opt.no{background:var(--nobg);border-color:var(--no);color:var(--no)}');\nh.push('.exp{display:none;margin-top:12px;padding:12px 14px;border-radius:10px;background:#f3efe7;font-size:15px;color:var(--muted)}');\nh.push('#score{margin-top:24px;text-align:center;font-size:18px;font-weight:600}');\nh.push('</style></head><body>');\nh.push('<h1>Desafío del día</h1>');\nh.push('<p class=\"sub\">Toca una opcion. Vas a ver enseguida si acertaste y por que.</p>');\nh.push('<div id=\"app\"></div><div id=\"score\"></div>');\nh.push('<script id=\"datos\" type=\"application/json\">' + JSON.stringify(dados) + '</' + 'script>');\nh.push('<script>');\nh.push('var SEM=' + JSON.stringify(semana) + ';');\nh.push('var W=\"https://YOUR_N8N_DOMAIN/webhook/YOUR_WEBHOOK_PATH\";');\nh.push('function avisar(n,r,ok){try{new Image().src=W+\"?s=\"+encodeURIComponent(SEM)+\"&p=\"+n+\"&r=\"+encodeURIComponent(r)+\"&ok=\"+(ok?1:0);}catch(e){}}');\nh.push('var D=JSON.parse(document.getElementById(\"datos\").textContent);');\nh.push('var app=document.getElementById(\"app\"),hechas=0,bien=0;');\nh.push('function norm(s){return String(s).trim().toLowerCase();}');\nh.push('D.forEach(function(q,i){');\nh.push('var d=document.createElement(\"div\");d.className=\"q\";');\nh.push('var t=document.createElement(\"p\");t.className=\"qt\";t.textContent=(i+1)+\". \"+q.p;d.appendChild(t);');\nh.push('var ex=document.createElement(\"div\");ex.className=\"exp\";');\nh.push('q.o.forEach(function(op){');\nh.push('var b=document.createElement(\"button\");b.className=\"opt\";b.textContent=op;');\nh.push('b.onclick=function(){');\nh.push('var todos=d.querySelectorAll(\".opt\");');\nh.push('for(var k=0;k<todos.length;k++){todos[k].disabled=true;}');\nh.push('var acerto=norm(op)===norm(q.g);');\nh.push('b.className=acerto?\"opt ok\":\"opt no\";');\nh.push('if(!acerto){for(var k=0;k<todos.length;k++){if(norm(todos[k].textContent)===norm(q.g)){todos[k].className=\"opt ok\";}}}');\nh.push('ex.style.display=\"block\";');\nh.push('ex.textContent=(acerto?\"Correcto. \":\"La respuesta era: \"+q.g+\". \")+(q.e||\"\");');\nh.push('avisar(i+1,op,acerto);');\nh.push('hechas++;if(acerto){bien++;}');\nh.push('if(hechas===D.length){document.getElementById(\"score\").textContent=\"Terminaste: \"+bien+\" de \"+D.length+\".\";}');\nh.push('};d.appendChild(b);});');\nh.push('d.appendChild(ex);app.appendChild(d);});');\nh.push('</' + 'script></body></html>');\n\nconst html = h.join(String.fromCharCode(10));\nconst caminho = 'enquetes/' + semana + '.html';\nconst url = 'https://YOUR_GITHUB_USER.github.io/YOUR_PAGES_REPO/' + caminho;\n\nreturn [{ json: {\n  html: html,\n  caminho: caminho,\n  url: url,\n  semana: semana,\n  destino: base.destino,\n  instancia: base.instancia\n} }];"
      },

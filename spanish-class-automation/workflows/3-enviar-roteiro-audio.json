    {
      "id": "2aa53dc6-c114-415f-9d68-47dd61d601fe",
      "name": "Montar mensagem da noite",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfgLinhas = $('Ler config').all();\nconst cfg = {};\nfor (let i = 0; i < cfgLinhas.length; i++) {\n  const l = cfgLinhas[i].json;\n  if (l.chave) cfg[String(l.chave).trim()] = String(l.valor).trim();\n}\n\nif ((cfg.ativo || 'sim').toLowerCase() !== 'sim') return [];\n\nconst agora = new Date();\nconst nomes = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sab'];\nconst diaHoje = nomes[agora.getDay()];\nif (diaHoje !== 'qua') return [];\n\nconst diaSemana = agora.getDay();\nconst segunda = new Date(agora);\nsegunda.setDate(agora.getDate() + (1 - diaSemana));\nconst semanaHoje = segunda.getFullYear() + '-' + String(segunda.getMonth() + 1).padStart(2, '0') + '-' + String(segunda.getDate()).padStart(2, '0');\n\nconst linhas = $input.all();\nlet alvo = null;\nfor (let i = 0; i < linhas.length; i++) {\n  const r = linhas[i].json;\n  if (String(r.dia || '').trim() !== 'qua') continue;\n  if (String(r.semana || '').trim() !== semanaHoje) continue;\n  if (String(r.status || '').trim().toLowerCase() !== 'enviado') continue;\n  if (!String(r.guion || '').trim()) continue;\n  alvo = r;\n  break;\n}\n\nif (!alvo) return [];\n\nconst nl = String.fromCharCode(10);\nconst mensagem = 'El texto del audio de hoy, por si lo quieres escuchar otra vez siguiendo la lectura.'\n  + nl + nl + String(alvo.guion).trim();\n\nreturn [{ json: { mensagem: mensagem, destino: cfg.destino, instancia: cfg.instancia } }];"
      }
    },

      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst q = $input.first().json.query || {};\n\nconst agora = new Date();\nfunction dois(n) { return String(n).padStart(2, '0'); }\nconst momento = agora.getFullYear() + '-' + dois(agora.getMonth() + 1) + '-' + dois(agora.getDate())\n  + ' ' + dois(agora.getHours()) + ':' + dois(agora.getMinutes());\n\nreturn [{ json: {\n  momento: momento,\n  semana: String(q.s || '').slice(0, 20),\n  pergunta: String(q.p || '').slice(0, 5),\n  resposta: String(q.r || '').slice(0, 60),\n  acertou: String(q.ok || '') === '1' ? 'sim' : 'nao'\n} }];\n"
      }
    },
